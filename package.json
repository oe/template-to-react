{
  "name": "template-to-react",
  "description": "compile html string template to react component",
  "author": {
    "name": "Saiya",
    "url": "https://evecalm.com/"
  },
  "keywords": [
    "react",
    "template",
    "html",
    "string",
    "transpiler",
    "compiler",
    "converter"
  ],
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/oe/template-to-react"
  },
  "version": "0.1.1",
  "type": "module",
  "main": "dist/index.umd.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "vite serve example",
    "build": "pnpm typecheck && vite build",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:package": "node scripts/check-package.mjs",
    "prepublishOnly": "pnpm test:coverage && pnpm build && pnpm test:package",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pegjs": "^0.10.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vitest": "5.0.3",
    "unplugin-dts": "^1.1.2",
    "@microsoft/api-extractor": "^7.59.3"
  },
  "dependencies": {
    "pegjs": "^0.10.0"
  },
  "license": "MIT",
  "packageManager": "pnpm@12.8.1",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.umd.cjs"
      }
    }
  }
}
